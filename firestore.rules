rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBookmark(data, userId) {
      return data.keys().hasAll(['userId', 'itemKey', 'title', 'category', 'createdAt'])
        && data.keys().hasOnly(['userId', 'itemKey', 'title', 'category', 'createdAt'])
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.itemKey is string && data.itemKey.size() >= 3 && data.itemKey.size() <= 64
        && data.itemKey.matches('^(nutrient|vitamin|deficiency|food):[0-9]+$')
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 80
        && data.createdAt is timestamp;
    }

    function isValidQuizAttempt(data, userId) {
      return data.keys().hasAll(['userId', 'score', 'total', 'percentage', 'createdAt'])
        && data.keys().hasOnly(['userId', 'score', 'total', 'percentage', 'createdAt'])
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.score is int && data.score >= 0 && data.score <= 50
        && data.total is int && data.total >= 1 && data.total <= 50 && data.score <= data.total
        && data.percentage is int && data.percentage >= 0 && data.percentage <= 100
        && data.createdAt is timestamp;
    }

    function isValidMealLog(data, userId) {
      return data.keys().hasAll(['userId', 'foodName', 'foodCategory', 'calories', 'mealSlot', 'loggedDate', 'createdAt'])
        && data.keys().hasOnly(['userId', 'foodName', 'foodCategory', 'calories', 'mealSlot', 'loggedDate', 'createdAt'])
        && data.userId is string && data.userId == userId && isValidId(data.userId)
        && data.foodName is string && data.foodName.size() >= 1 && data.foodName.size() <= 120
        && data.foodCategory is string && data.foodCategory.size() >= 1 && data.foodCategory.size() <= 80
        && data.calories is int && data.calories >= 0 && data.calories <= 5000
        && data.mealSlot in ['Breakfast', 'Lunch', 'Snack', 'Dinner']
        && data.loggedDate is string && data.loggedDate.size() == 10
        && data.loggedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isVerifiedOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if false;

      match /bookmarks/{bookmarkId} {
        allow get: if isValidId(userId) && isValidId(bookmarkId) && isVerifiedOwner(userId);
        allow list: if isValidId(userId)
          && isVerifiedOwner(userId)
          && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(bookmarkId)
          && isVerifiedOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidBookmark(incoming(), userId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(bookmarkId) && isVerifiedOwner(userId);
      }

      match /quizAttempts/{attemptId} {
        allow get: if isValidId(userId) && isValidId(attemptId) && isVerifiedOwner(userId);
        allow list: if isValidId(userId)
          && isVerifiedOwner(userId)
          && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(attemptId)
          && isVerifiedOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidQuizAttempt(incoming(), userId)
          && incoming().createdAt == request.time;
        allow update, delete: if false;
      }

      match /mealLogs/{logId} {
        allow get: if isValidId(userId) && isValidId(logId) && isVerifiedOwner(userId);
        allow list: if isValidId(userId)
          && isVerifiedOwner(userId)
          && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(logId)
          && isVerifiedOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidMealLog(incoming(), userId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(logId) && isVerifiedOwner(userId);
      }
    }
  }
}
