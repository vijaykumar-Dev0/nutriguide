{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private authenticated learner profile stored under the user's UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Authentication UID matching the document ID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Learner display name."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 512,
          "description": "Optional profile avatar URL."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was last updated."
        }
      },
      "required": ["uid", "displayName", "createdAt", "updatedAt"]
    },
    "UserBookmark": {
      "title": "UserBookmark",
      "description": "A saved nutrient, vitamin, deficiency guide, or healthy food bookmark.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "itemKey": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^(nutrient|vitamin|deficiency|food):[0-9]+$",
          "description": "Normalized nutrition entity key."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Display title of the bookmarked item."
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Category label of the bookmarked item."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["userId", "itemKey", "title", "category", "createdAt"]
    },
    "QuizAttempt": {
      "title": "QuizAttempt",
      "description": "Completed 10-question nutrition quiz attempt recorded by the learner.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "score": {
          "type": "number",
          "description": "Number of correct answers (0-10)."
        },
        "total": {
          "type": "number",
          "description": "Total number of questions."
        },
        "percentage": {
          "type": "number",
          "description": "Calculated percentage score (0-100)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["userId", "score", "total", "percentage", "createdAt"]
    },
    "MealLog": {
      "title": "MealLog",
      "description": "Daily healthy meal log entry created by the authenticated learner.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "foodName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Name of the logged healthy food."
        },
        "foodCategory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Food category name."
        },
        "calories": {
          "type": "number",
          "description": "Estimated kcal for the serving."
        },
        "mealSlot": {
          "type": "string",
          "enum": ["Breakfast", "Lunch", "Snack", "Dinner"],
          "description": "Daily meal slot."
        },
        "loggedDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "ISO calendar date YYYY-MM-DD."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["userId", "foodName", "foodCategory", "calories", "mealSlot", "loggedDate", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private learner profile document owned by {userId}."
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": { "$ref": "#/entities/UserBookmark" },
      "description": "Subcollection of nutrition bookmarks owned by {userId}."
    },
    "/users/{userId}/quizAttempts/{attemptId}": {
      "schema": { "$ref": "#/entities/QuizAttempt" },
      "description": "Subcollection of quiz results owned by {userId}."
    },
    "/users/{userId}/mealLogs/{logId}": {
      "schema": { "$ref": "#/entities/MealLog" },
      "description": "Subcollection of daily healthy meal logs owned by {userId}."
    }
  }
}
